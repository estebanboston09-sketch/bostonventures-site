---
import { AREAS } from '../lib/site';
import AreaArt from './AreaArt.astro';
import { hotelImage } from '../lib/hotelImage';
import { overallScore } from '../lib/score';
interface Props { hotel: any }
const { hotel } = Astro.props;
const d = hotel.data;
const reviewed = !!d.review;
const overall = overallScore(d.review);
const price = d.priceLevel ? '$'.repeat(d.priceLevel) : null;
const img = hotelImage(d);
---
<a href={`/hotels/${hotel.id}`} class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-md"
  data-hotel
  data-area={d.area}
  data-ai={d.allInclusive ? '1' : '0'}
  data-adults={d.adultsOnly ? '1' : '0'}
  data-reviewed={reviewed ? '1' : '0'}
  data-price={d.priceLevel ?? ''}
  data-tags={d.bestFor.join(' ')}
  data-name={d.name.toLowerCase()}>
  <div class="relative h-44 overflow-hidden bg-sand-2">
    {img
      ? <img src={img.src} alt={img.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      : <AreaArt area={d.area} seed={hotel.id} class="absolute inset-0 h-full w-full transition duration-500 group-hover:scale-105" />}
    <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></div>
    <span class:list={['absolute bottom-3 left-3 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide', reviewed ? 'bg-sun text-navy' : 'bg-white/90 text-navy/70']}>
      {reviewed ? '★ Reviewed by BostonVentures' : 'Not reviewed yet'}
    </span>
    {overall != null && <span class="absolute bottom-3 right-3 grid h-12 w-12 place-items-center rounded-full border-2 border-white bg-navy font-serif text-lg font-bold text-sun shadow">{overall}</span>}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-bold text-navy group-hover:underline">{d.name}</h3>
    <p class="mt-0.5 text-sm text-ink/60">{AREAS[d.area]?.label ?? 'Riviera Maya'}{price && <> · {price}</>}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {d.allInclusive && <span class="chip">All-inclusive</span>}
      {d.adultsOnly ? <span class="chip">Adults-only</span> : <span class="chip">Kids welcome</span>}
    </div>
  </div>
</a>
