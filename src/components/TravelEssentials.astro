---
import { AFFILIATE } from '../lib/site';
interface Props { compact?: boolean; noTransfer?: boolean }
const { compact = false, noTransfer = false } = Astro.props;
---
<div class:list={['grid gap-4', !compact && !noTransfer && 'sm:grid-cols-2']}>
  {!noTransfer && <div class="card p-5">
    <p class="eyebrow">Getting there</p>
    <h3 class="mt-1 font-bold text-navy">Book your airport transfer before you land</h3>
    <p class="mt-1 text-sm text-ink/70">A pre-booked driver waits outside with your name, so you skip the taxi and timeshare crowd in the arrivals hall.</p>
    <a href={AFFILIATE.transfers.url} target="_blank" rel="sponsored nofollow noopener" class="btn-sun mt-4 text-sm">Get a transfer price →</a>
  </div>}
  <div class="card p-5">
    <p class="eyebrow">Stay connected</p>
    <h3 class="mt-1 font-bold text-navy">Have data the moment you land</h3>
    <p class="mt-1 text-sm text-ink/70">Install an eSIM at home and turn it on at the airport, so you have maps, Uber and WhatsApp right away. {AFFILIATE.esim.deal}.</p>
    <a href={AFFILIATE.esim.url} target="_blank" rel="sponsored nofollow noopener" class="btn-sun mt-4 text-sm">See Holafly eSIMs →</a>
  </div>
</div>
