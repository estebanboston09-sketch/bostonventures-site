---
import { overallScore } from '../lib/score';
interface Props { review: any }
const { review } = Astro.props;
const overall = overallScore(review);
const fmt = (n: number) => (Number.isInteger(n) ? n.toFixed(0) : n.toFixed(1));
---
<div class="rounded-2xl bg-navy p-5 text-white">
  <div class="flex items-center gap-4 border-b border-white/25 pb-4">
    {overall != null
      ? <div class="grid h-20 w-20 shrink-0 place-items-center rounded-full border-2 border-sun font-serif text-3xl font-bold text-sun">{fmt(overall)}</div>
      : <div class="grid h-20 w-20 shrink-0 place-items-center rounded-full border-2 border-white/40 text-center text-xs font-semibold leading-tight">My<br/>scores</div>}
    <div>
      <p class="eyebrow">{overall != null ? 'Overall score' : 'Category scores'}</p>
      <p class="text-sm text-teal">out of 10, after a real stay</p>
      {review.pricePaid && <p class="mt-1 text-sm">Price paid: <b class="text-white">{review.pricePaid}</b></p>}
    </div>
  </div>
  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {review.scores.map((i: any) => (
      <li class="rounded-xl border border-white/25 bg-white/5 p-3 text-center">
        <p class="font-serif text-2xl font-bold">{fmt(i.value)}</p>
        <p class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-teal">{i.label}</p>
      </li>
    ))}
  </ul>
</div>
