---
import { overallScore } from '../lib/score';
interface Props { review: any }
const { review: r } = Astro.props;
const overall = overallScore(r);
const fmt = (n: number) => (Number.isInteger(n) ? n.toFixed(0) : n.toFixed(1));
const label = (n: number) => (n >= 9 ? 'Excellent' : n >= 8 ? 'Very good' : n >= 7 ? 'Good' : n >= 6 ? 'Okay' : 'Skip it');
const C = 2 * Math.PI * 52;
---
<section class="verdict reveal overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-navy/5">
  <div class="grid gap-6 bg-navy p-6 text-white sm:grid-cols-[auto_1fr] sm:items-center sm:p-8">
    {overall != null ? (
      <div class="relative mx-auto h-36 w-36">
        <svg viewBox="0 0 120 120" class="h-full w-full -rotate-90">
          <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="10" />
          <circle class="ring-fill" cx="60" cy="60" r="52" fill="none" stroke="#FFD54A" stroke-width="10" stroke-linecap="round"
            stroke-dasharray={C} stroke-dashoffset={C} data-target={C * (1 - overall / 10)} />
        </svg>
        <div class="absolute inset-0 grid place-content-center text-center">
          <span class="count font-serif text-4xl font-bold text-sun" data-to={overall}>0</span>
          <span class="text-[11px] font-bold uppercase tracking-widest text-teal">{label(overall)}</span>
        </div>
      </div>
    ) : (
      <div class="mx-auto grid h-36 w-36 place-content-center rounded-full border-4 border-white/20 text-center">
        <span class="text-3xl">🎬</span><span class="mt-1 text-xs font-bold uppercase tracking-widest text-teal">Video review</span>
      </div>
    )}
    <div>
      <p class="eyebrow">My verdict</p>
      {r.verdict && <p class="mt-2 text-lg leading-relaxed sm:text-xl">“{r.verdict}”</p>}
      {r.pricePaid && <p class="mt-3 inline-flex rounded-full bg-white/10 px-3 py-1 text-sm">💵 Paid: <b class="ml-1">{r.pricePaid}</b></p>}
    </div>
  </div>

  {r.scores.length > 0 && (
    <div class="p-6 sm:p-8">
      <p class="mb-4 text-sm font-bold text-navy">Scores by category <span class="font-normal text-ink/50">— tap one to read more</span></p>
      <ul class="space-y-3">
        {r.scores.map((s: any, i: number) => (
          <li>
            <button type="button" class="score-row group w-full text-left" data-goto={s.label}>
              <div class="flex items-baseline justify-between gap-3 text-sm">
                <span class="font-semibold text-navy group-hover:underline">{s.label}</span>
                <span class="font-serif text-lg font-bold text-navy">{fmt(s.value)}</span>
              </div>
              <div class="mt-1.5 h-2.5 overflow-hidden rounded-full bg-sand-2">
                <div class="bar h-full w-0 rounded-full bg-gradient-to-r from-[#14A3C7] to-gold transition-[width] duration-1000 ease-out" style={`--w:${s.value * 10}%; transition-delay:${i * 90}ms`}></div>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>
  )}

  {(r.pros.length > 0 || r.cons.length > 0) && (
    <div class="border-t border-navy/5 p-6 sm:p-8">
      <div class="seg inline-flex rounded-full bg-sand-2 p-1 text-sm font-semibold" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-seg="pros" class="seg-btn">👍 What I loved</button>
        <button type="button" role="tab" aria-selected="false" data-seg="cons" class="seg-btn">👎 Could be better</button>
      </div>
      <ul data-seg-panel="pros" class="mt-4 grid gap-2 sm:grid-cols-2">
        {r.pros.map((p: string, i: number) => <li class="pop flex gap-2 rounded-xl bg-[#22B07D]/10 px-3 py-2.5 text-sm" style={`--d:${i * 60}ms`}><span class="text-[#22B07D]">✓</span>{p}</li>)}
      </ul>
      <ul data-seg-panel="cons" hidden class="mt-4 grid gap-2 sm:grid-cols-2">
        {r.cons.map((p: string, i: number) => <li class="pop flex gap-2 rounded-xl bg-[#ff6b4a]/10 px-3 py-2.5 text-sm" style={`--d:${i * 60}ms`}><span class="text-[#e0532f]">✗</span>{p}</li>)}
      </ul>
    </div>
  )}
</section>
<script>
  const card = document.querySelector<HTMLElement>('.verdict');
  if (card) {
    const run = () => {
      card.querySelectorAll<SVGCircleElement>('.ring-fill').forEach((c) => (c.style.strokeDashoffset = c.dataset.target!));
      card.querySelectorAll<HTMLElement>('.bar').forEach((b) => (b.style.width = 'var(--w)'));
      card.querySelectorAll<HTMLElement>('.count').forEach((el) => {
        const to = Number(el.dataset.to), dec = Number.isInteger(to) ? 0 : 1, t0 = performance.now();
        const step = (t: number) => { const k = Math.min(1, (t - t0) / 1100); el.textContent = (to * (1 - Math.pow(1 - k, 3))).toFixed(dec); if (k < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      });
    };
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { run(); o.disconnect(); } }, { threshold: 0.3 }).observe(card);
    card.querySelector('.seg')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-seg]'); if (!b) return;
      card.querySelectorAll('[data-seg]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      card.querySelectorAll<HTMLElement>('[data-seg-panel]').forEach((p) => (p.hidden = p.dataset.segPanel !== b.dataset.seg));
    });
  }
</script>
