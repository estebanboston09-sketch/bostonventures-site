---
// Thumbnail first; the YouTube player only loads on click (keeps pages fast).
// Anything on the page with data-play-at="<seconds>" jumps this video to that moment.
interface Props { id: string; title: string; chapters?: { label: string; start: number }[] }
const { id, title, chapters = [] } = Astro.props;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---
<div class="lite-yt group/yt relative aspect-video overflow-hidden rounded-2xl bg-navy shadow-lg ring-1 ring-navy/10" data-id={id}>
  <button type="button" class="absolute inset-0 h-full w-full" aria-label={`Play video: ${title}`} data-play-at="0">
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover/yt:scale-105" />
    <span class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></span>
    <span class="absolute inset-0 grid place-items-center">
      <span class="play-pulse grid h-20 w-20 place-items-center rounded-full bg-[#ff0033] shadow-xl transition group-hover/yt:scale-110">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
      </span>
    </span>
  </button>
</div>
{chapters.length > 0 && (
  <div class="mt-3 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
    <span class="shrink-0 self-center text-xs font-bold uppercase tracking-wide text-ink/50">Jump to</span>
    {chapters.map((c) => (
      <button type="button" data-play-at={c.start} class="chip-btn shrink-0">
        <span class="font-mono text-[11px] text-ink/50">{fmt(c.start)}</span> {c.label}
      </button>
    ))}
  </div>
)}
<script>
  function play(start: number) {
    const el = document.querySelector<HTMLElement>('.lite-yt');
    if (!el) return;
    el.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&start=${Math.floor(start)}&rel=0" title="YouTube video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    const r = el.getBoundingClientRect();
    if (r.top < 80 || r.bottom > innerHeight) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-play-at]');
    if (b) { e.preventDefault(); play(Number(b.dataset.playAt)); }
  });
</script>
