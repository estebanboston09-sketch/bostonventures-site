---
import { SITE } from '../lib/site';
import Logo from './Logo.astro';
const links = [
  { href: '/hotels', label: 'Hotels' },
  { href: '/tours', label: 'Tours' },
  { href: '/guides', label: 'Guides' },
  { href: '/tools', label: 'Trip tools' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 bg-navy text-white transition-shadow">
  <div class="wrap bar-inner flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight">
      <Logo size={38} onDark id="logo-h" />
      <span class="text-lg">Boston<span class="text-sun">Ventures</span></span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['rounded-full px-3.5 py-2 text-sm font-semibold hover:bg-white/10', path.startsWith(l.href) && 'bg-white/10 text-sun']}>{l.label}</a>
      ))}
      <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="ml-2 inline-flex items-center gap-1.5 rounded-full bg-[#ff0033] px-3.5 py-2 text-sm font-bold">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.1V8.9l5.8 3.1-5.8 3.1Z"/></svg>
        Subscribe
      </a>
    </nav>
    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded-full p-2 hover:bg-white/10" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-2xl bg-navy-2 p-2 shadow-xl ring-1 ring-white/10">
        {links.map((l) => <a href={l.href} class="block rounded-xl px-4 py-3 font-semibold hover:bg-white/10">{l.label}</a>)}
        <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="mt-1 block rounded-xl bg-[#ff0033] px-4 py-3 font-bold">Subscribe on YouTube</a>
      </div>
    </details>
  </div>
</header>
