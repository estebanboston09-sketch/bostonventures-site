---
import { SITE } from '../lib/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="mt-20 bg-navy text-white/80">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="flex items-center gap-2 text-lg font-bold text-white"><Logo size={34} onDark id="logo-f" />Boston<span class="-ml-2 text-sun">Ventures</span></p>
      <p class="mt-2 text-sm">{SITE.tagline}</p>
      <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-semibold text-sun hover:underline">Watch on YouTube →</a>
    </div>
    <div>
      <p class="eyebrow">Plan</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href="/tools/trip-planner">Trip planner</a></li>
        <li><a class="hover:text-white" href="/tools/hotel-match">Find your hotel</a></li>
        <li><a class="hover:text-white" href="/tools/tour-finder">Find your tours</a></li>
        <li><a class="hover:text-white" href="/hotels/compare">Compare hotels</a></li>
        <li><a class="hover:text-white" href="/tools/fair-prices">Fair price checker</a></li>
        <li><a class="hover:text-white" href="/map">Map</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href="/hotels">All hotels</a></li>
        <li><a class="hover:text-white" href="/hotels?reviewed=1">Reviewed hotels</a></li>
        <li><a class="hover:text-white" href="/tours">Tours & day trips</a></li>
        <li><a class="hover:text-white" href="/guides">All guides</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">About</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href="/about">About Esteban</a></li>
        <li><a class="hover:text-white" href="/review-policy">How reviews work</a></li>
        <li><a class="hover:text-white" href="/affiliate-disclosure">Affiliate disclosure</a></li>
        <li><a class="hover:text-white" href="/privacy">Privacy</a></li>
        <li><a class="hover:text-white" href="/terms">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="wrap py-5 text-xs text-white/50">© {year} BostonVentures. Some links earn us a commission at no extra cost to you. Prices change; always confirm before you book.</p>
  </div>
</footer>
