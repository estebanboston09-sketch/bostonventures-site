---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE, ANALYTICS } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object | object[];
  noindex?: boolean;
}
const { title, description, image, schema, noindex = false } = Astro.props;
// The site builds files like /golf.html but serves them at /golf, so drop ".html" (and "index").
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const siteUrl = Astro.site!.href;
// Site-wide identity for Google and AI search: who runs the site and where else they publish.
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${siteUrl}#org`, name: SITE.name, url: siteUrl, logo: new URL('/favicon.svg', siteUrl).href,
      description: 'Free English travel guide to Cancún and the Riviera Maya by a local hotel reviewer: honest hotel reviews with scores, tour advice and trip tools.',
      sameAs: [SITE.youtube], founder: { '@id': `${siteUrl}#esteban` }, areaServed: ['Cancún', 'Riviera Maya', 'Quintana Roo, Mexico'] },
    { '@type': 'Person', '@id': `${siteUrl}#esteban`, name: 'Esteban', jobTitle: 'Hotel reviewer and local guide', homeLocation: { '@type': 'Place', name: 'Cancún, Mexico' },
      worksFor: { '@id': `${siteUrl}#org` }, sameAs: [SITE.youtube], url: new URL('/about', siteUrl).href },
    { '@type': 'WebSite', '@id': `${siteUrl}#website`, name: SITE.name, url: siteUrl, publisher: { '@id': `${siteUrl}#org` }, inLanguage: 'en' },
  ],
};
const schemas = [siteGraph, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
const phToken = ANALYTICS.posthogToken;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // One address only: send visitors from the temporary workers.dev address and www to the main domain.
      (function () { var h = location.hostname; if (h.endsWith('workers.dev') || h === 'www.bostonventurestravel.com') location.replace('https://bostonventurestravel.com' + location.pathname + location.search + location.hash); })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0A6E94" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {phToken && <meta name="ph-token" content={phToken} data-host={ANALYTICS.posthogHost} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <div id="progress" aria-hidden="true"></div>
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
    <ChatWidget />
    <script>
      // Reveal elements as they scroll in, reading progress bar, header shadow.
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      const bar = document.getElementById('progress'), hdr = document.querySelector('header');
      const onScroll = () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = h > 0 ? `${(scrollY / h) * 100}%` : '0';
        hdr?.classList.toggle('scrolled', scrollY > 10);
      };
      addEventListener('scroll', onScroll, { passive: true }); onScroll();
    </script>
      <script>
      // PostHog: pageviews, clicks, heatmaps and session replays (turn replays/heatmaps on in PostHog settings),
      // plus named events for the things that matter: affiliate clicks, video plays, tool use.
      const m = document.querySelector<HTMLMetaElement>('meta[name="ph-token"]');
      // Esteban's own devices: open the site once with ?me to stop counting this device (?me=off to undo).
      let isMe = false;
      try {
        const q = new URLSearchParams(location.search);
        if (q.has('me')) {
          const off = q.get('me') === 'off';
          off ? localStorage.removeItem('bv-me') : localStorage.setItem('bv-me', '1');
          q.delete('me');
          history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : '') + location.hash);
          const toast = document.createElement('div');
          toast.textContent = off ? '📊 This device is counted in analytics again.' : '✅ This device is no longer counted in analytics.';
          toast.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;background:#0A3D52;color:#fff;padding:12px 18px;border-radius:9999px;font:600 14px system-ui;box-shadow:0 6px 20px rgba(0,0,0,.25)';
          document.body.appendChild(toast); setTimeout(() => toast.remove(), 4000);
        }
        isMe = localStorage.getItem('bv-me') === '1';
      } catch {}
      if (m && !isMe && !/localhost|127\.0\.0\.1|workers\.dev/.test(location.hostname)) {
        const { default: posthog } = await import('posthog-js'); // only downloaded when analytics is on
        posthog.init(m.content, { api_host: m.dataset.host, defaults: '2026-01-30', person_profiles: 'identified_only', respect_dnt: true });
        (window as any).posthog = posthog; // lets tool pages send their own events
        document.addEventListener('click', (e) => {
          const el = e.target as HTMLElement;
          const a = el.closest<HTMLAnchorElement>('a[href]');
          if (a && a.host && a.host !== location.host) {
            const sponsored = (a.rel || '').includes('sponsored');
            const host = a.host.replace(/^www\./, '');
            const names: Record<string, string> = { 'booking.usa-transfers.com': 'USA Transfers', 'holafly.sjv.io': 'Holafly', 'booking.com': 'Booking.com' };
            const hotel = location.pathname.startsWith('/hotels/') && location.pathname !== '/hotels/compare'
              ? (document.querySelector('h1')?.textContent || '').trim() : undefined;
            posthog.capture(sponsored ? 'affiliate_click' : 'outbound_click', {
              url: a.href, partner: names[host] || host, hotel, label: (a.textContent || '').trim().slice(0, 80), page: location.pathname,
            });
          }
          const v = el.closest<HTMLElement>('[data-play-at]');
          if (v) posthog.capture('video_play', { at_second: Number(v.dataset.playAt), page: location.pathname });
          const t = el.closest<HTMLElement>('[data-track]');
          if (t) posthog.capture(t.dataset.track!, { label: (t.textContent || '').trim().slice(0, 80), page: location.pathname });
        }, { capture: true });
      }
    </script>
  </body>
</html>
