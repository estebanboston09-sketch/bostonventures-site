---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => b.data.updated.localeCompare(a.data.updated));
const fixed = [{ href: '/guides/cancun-airport', emoji: '✈️', title: 'Cancún airport arrival guide', text: 'Step by step from the plane to your hotel, without getting scammed.' }];
---
<Base title="Cancún & Riviera Maya Travel Guides From a Local" description="Straight answers to every question about a trip to Cancún and the Riviera Maya — airport, money, safety, areas, seasons and day trips — from a local.">
  <section class="bg-navy py-12 text-white"><div class="wrap">
    <p class="eyebrow">Guides</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Straight answers from a local</h1>
    <p class="mt-2 max-w-2xl text-white/75">Every question you have before and during your trip, answered by someone who lives here. New guides every week.</p>
  </div></section>
  <div class="wrap mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {fixed.map((g) => <a href={g.href} class="card lift reveal group p-6"><span class="text-3xl">{g.emoji}</span><h2 class="mt-3 text-lg font-bold text-navy group-hover:underline">{g.title}</h2><p class="mt-1 text-sm text-ink/70">{g.text}</p></a>)}
    {guides.map((g) => <a href={`/guides/${g.id}`} class="card lift reveal group p-6"><span class="text-3xl">{g.data.emoji}</span><h2 class="mt-3 text-lg font-bold text-navy group-hover:underline">{g.data.title}</h2><p class="mt-1 text-sm text-ink/70">{g.data.description}</p></a>)}
  </div>
</Base>
