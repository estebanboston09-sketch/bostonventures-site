---
import Base from '../../layouts/Base.astro';
import TravelEssentials from '../../components/TravelEssentials.astro';
import Disclosure from '../../components/Disclosure.astro';
import TerminalPicker from '../../components/TerminalPicker.astro';
const faq = [
  { q: 'Which terminal will I arrive at in Cancún?', a: 'Cancún has four terminals. Terminal 3 is for the big US airlines and Air Canada (American, Delta, United). Terminal 4 has Southwest, JetBlue, Frontier, WestJet, Aeroméxico and most European airlines. Terminal 2 is for flights within Mexico (Viva, Volaris) and Latin American airlines. The rebuilt Terminal 1 is coming back into use in late 2026. Your boarding pass always shows the terminal.' },
  { q: 'Can I move between terminals?', a: 'Yes. A free shuttle bus links the terminals about every 10–15 minutes from marked stops outside. Never pay anyone for it.' },
  { q: 'How do I get from Cancún airport to my hotel?', a: 'A pre-booked private or shared transfer is the easiest: the driver waits outside with your name. ADO buses are the cheapest option to downtown Cancún and Playa del Carmen. Airport taxis are the most expensive.' },
  { q: 'Who are the people offering help after customs?', a: 'Inside the terminal, after customs, you walk through a hall of sellers offering taxis, tours and "free" gifts — often timeshare sales. Say "no, gracias" and keep walking outside to find your driver.' },
  { q: 'How early should I get to the airport to fly home?', a: 'About 3 hours before an international flight. Lines at check-in and security can be long, especially on Saturdays and in high season.' },
];
---
<Base title="Cancún Airport Arrival Guide (2026): Terminals, Airlines & Step by Step" description="Landing in Cancún? Find your terminal by airline (T1–T4), what happens after you land, how to skip the timeshare 'shark tank', and the easiest way to your hotel."
  schema={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}>
  <section class="bg-navy py-12 text-white"><div class="wrap max-w-3xl">
    <p class="eyebrow">Guide</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-5xl">Cancún airport arrival guide</h1>
    <p class="mt-3 text-white/75">Step by step, from the plane to your hotel pool — from someone who lives here.</p>
  </div></section>

  <div class="wrap mt-8 max-w-3xl space-y-8">
    <div class="card border-l-4 border-sun p-5">
      <p class="eyebrow">Short answer</p>
      <p class="mt-1">Book your transfer before you fly, turn on an eSIM when you land, walk straight through the sellers after customs, and meet your driver <b>outside</b> the terminal. That's it.</p>
    </div>

    <TerminalPicker />

    <ol class="space-y-4">
      {[
        ['Get off the plane and go through immigration', 'Follow the signs for Migración. Have your passport and your hotel address ready. Many travelers can now use the automatic e-gates, which are much faster.'],
        ['Collect your bags', 'Check the screens for your carousel. Bags can take a while when several big flights land together.'],
        ['Customs', 'Put your bags through the scanner and press the button if asked. Most people are waved through in seconds.'],
        ['Walk past the "shark tank"', 'Right after customs, there is a hall full of people offering taxis, tours, drinks and "free" gifts. Most are selling timeshares. Smile, say "no, gracias", and keep walking out the doors.'],
        ['Find your driver outside', 'Pre-booked transfer drivers wait outside holding a sign with your name. Turn on your eSIM or connect to Wi-Fi in case you need to message them.'],
        ['Get to your hotel', 'Most Hotel Zone resorts are 20–30 minutes away. Playa del Carmen is about 50 minutes, Tulum about 2 hours.'],
      ].map(([t, b], i) => (
        <li class="card flex gap-4 p-5">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-navy font-bold text-sun">{i + 1}</span>
          <div><h2 class="font-bold text-navy">{t}</h2><p class="mt-1 text-sm text-ink/70">{b}</p></div>
        </li>
      ))}
    </ol>

    <TravelEssentials />

    <section class="prose-bv">
      <h2>Your options from the airport</h2>
      <ul>
        <li><strong>Private transfer (easiest):</strong> door to door, waiting for you even if your flight is late. Best for families, groups and late arrivals.</li>
        <li><strong>Shared shuttle:</strong> cheaper, but you stop at other hotels first.</li>
        <li><strong>ADO bus (cheapest):</strong> comfortable buses from the terminals to downtown Cancún and Playa del Carmen. You'll still need a taxi to your hotel.</li>
        <li><strong>Airport taxi:</strong> available, but usually the most expensive way to go.</li>
      </ul>
      <h2>Flying home</h2>
      <p>Leave your hotel about <strong>3 hours</strong> before an international flight. Check your terminal on your boarding pass — if you go to the wrong one, take the free shuttle between terminals.</p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-navy">Questions people ask</h2>
      <div class="mt-3 space-y-2">{faq.map((f) => <details class="card p-4"><summary class="cursor-pointer font-semibold text-navy">{f.q}</summary><p class="mt-2 text-sm text-ink/70">{f.a}</p></details>)}</div>
    </section>
    <Disclosure />
    <p class="text-xs text-ink/50">Last checked: November 2026. Airport procedures change; confirm with your airline.</p>
  </div>
</Base>
