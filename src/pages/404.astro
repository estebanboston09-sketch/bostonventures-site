---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap max-w-xl py-24 text-center">
    <p class="text-6xl">🌴</p>
    <h1 class="mt-4 text-3xl font-bold text-navy">This page went to the beach</h1>
    <p class="mt-2 text-ink/70">It doesn't exist (or it moved). Try one of these:</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3"><a href="/" class="btn-sun">Home</a><a href="/hotels" class="btn-ghost">Hotels</a><a href="/tools" class="btn-ghost">Trip tools</a></div>
  </div>
</Base>
