---
import Base from '../../layouts/Base.astro';
import 'leaflet/dist/leaflet.css';
import { BEACHES, LEVELS, REPORT, SEASON, type Level } from '../../data/sargassum';
const order: Level[] = ['none', 'low', 'moderate', 'abundant', 'excessive'];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const areas = [...new Set(BEACHES.map((b) => b.area))];
const best = BEACHES.filter((b) => b.level === 'low' || b.level === 'none');
const worst = BEACHES.filter((b) => b.level === 'abundant' || b.level === 'excessive');
const faq = [
  ['Is there seaweed in Cancún right now?', `On the ${fmt(REPORT.date)} official map, most Cancún beaches were at a low level. Playa Coral was the exception, with abundant seaweed. Levels change daily with wind and currents.`],
  ['When is seaweed season in Cancún?', 'It usually builds from April or May, peaks in June and July, and eases in September and October. November to March are normally the clearest months. 2026 was a record year that started early and ran late.'],
  ['Which Cancún beaches have the least seaweed?', 'The north-facing beaches at the start of the Hotel Zone (Las Perlas, Langosta, Tortugas, Caracol) and Playa Norte on Isla Mujeres face the calm bay, so they usually get much less than the open Caribbean side.'],
  ['Is sargassum dangerous?', 'Floating seaweed is not harmful to touch, but rotting piles on the sand release a rotten-egg smell (hydrogen sulfide) that can irritate eyes and breathing. Avoid sitting next to big rotting piles.'],
];
---
<Base title="Cancún Seaweed Map Today: Sargassum by Beach" description={`Which Cancún, Playa del Carmen, Tulum and Cozumel beaches have seaweed? Official sargassum levels by beach (${fmt(REPORT.date)}), the seaweed season month by month, and the best beaches to avoid it.`}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />
  <section class="bg-navy py-8 text-white">
    <div class="wrap">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">🌿 Seaweed map</h1>
      <p class="mt-2 max-w-2xl text-white/75">Where the sargassum is, beach by beach, from the official Quintana Roo seaweed monitoring map.</p>
      <p class="mt-3 inline-block rounded-full bg-white/10 px-3 py-1 text-sm">Official report: <b>{fmt(REPORT.date)}</b></p>
    </div>
  </section>

  <div class="wrap mt-6">
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="card p-4"><p class="text-sm text-ink/60">Cancún to Tulum (100 points)</p><p class="mt-1 font-serif text-2xl font-bold text-navy">{REPORT.north.low + REPORT.north.none}% low or clear</p></div>
      <div class="card p-4"><p class="text-sm text-ink/60">Abundant or excessive (north)</p><p class="mt-1 font-serif text-2xl font-bold text-navy">{REPORT.north.abundant + REPORT.north.excessive} beaches</p></div>
      <div class="card p-4"><p class="text-sm text-ink/60">South coast (Mahahual, Costa Maya)</p><p class="mt-1 font-serif text-2xl font-bold text-navy">{REPORT.south.abundant + REPORT.south.excessive} of {REPORT.south.total} heavy</p></div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2 text-sm" aria-label="Legend">
      {order.map((l) => <span class="flex items-center gap-1.5 rounded-full bg-white px-3 py-1 ring-1 ring-navy/10"><span class="h-3 w-3 rounded-full" style={`background:${LEVELS[l].color}`}></span>{LEVELS[l].label}</span>)}
    </div>
    <div id="map" class="mt-3 h-[60vh] min-h-[380px] overflow-hidden rounded-2xl shadow-sm ring-1 ring-navy/10"></div>
    <p class="mt-2 text-xs text-ink/50">Pins are approximate beach spots. Map data © OpenStreetMap contributors. Levels: {REPORT.source}, {fmt(REPORT.date)}.</p>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <section class="card p-6">
        <h2 class="text-xl font-bold text-navy">✅ Good beaches right now</h2>
        <p class="mt-1 text-sm text-ink/60">Low or no seaweed on the latest map.</p>
        <ul class="mt-3 grid grid-cols-1 gap-1 text-sm sm:grid-cols-2">{best.slice(0, 18).map((b) => <li><span class="font-semibold">{b.name}</span> <span class="text-ink/50">· {b.area}</span></li>)}</ul>
      </section>
      <section class="card p-6">
        <h2 class="text-xl font-bold text-navy">⚠️ Skip for now</h2>
        <p class="mt-1 text-sm text-ink/60">Abundant or excessive seaweed.</p>
        <ul class="mt-3 space-y-1 text-sm">{worst.map((b) => <li><span class="font-semibold">{b.name}</span> <span class="text-ink/50">· {b.area}</span> <span class="ml-1 rounded-full px-2 py-0.5 text-xs font-bold text-white" style={`background:${LEVELS[b.level].color}`}>{LEVELS[b.level].label}</span></li>)}</ul>
      </section>
    </div>

    <section class="mt-8">
      <h2 class="text-2xl font-bold text-navy">Every beach on the report</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {areas.map((a) => (
          <div class="card p-5">
            <h3 class="font-bold text-navy">{a}</h3>
            <ul class="mt-2 space-y-1 text-sm">
              {BEACHES.filter((b) => b.area === a).map((b) => <li class="flex items-center justify-between gap-2"><span>{b.name}</span><span class="flex items-center gap-1 text-xs text-ink/60"><span class="h-2.5 w-2.5 rounded-full" style={`background:${LEVELS[b.level].color}`}></span>{LEVELS[b.level].label}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8 card p-6">
      <h2 class="text-2xl font-bold text-navy">Seaweed season, month by month</h2>
      <p class="mt-1 text-sm text-ink/60">A typical year. It builds in spring, peaks in June and July and eases by October. 2026 was a record year: it started about two months early and lasted past September.</p>
      <div class="mt-4 grid grid-cols-6 gap-2 sm:grid-cols-12">
        {SEASON.map((s) => <div class="text-center"><div class="h-14 rounded-lg" style={`background:${LEVELS[s.risk].color}`} title={LEVELS[s.risk].label}></div><p class="mt-1 text-xs font-semibold">{s.m}</p></div>)}
      </div>
      <p class="mt-4 text-sm">Want the full picture with weather, hurricanes and prices? <a href="/tools/best-time" class="font-bold text-navy underline">See the best time to visit →</a></p>
    </section>

    <section class="mt-8 grid gap-4 sm:grid-cols-2">
      {[
        ['🏖️ Pick the bay side', 'Beaches facing north into the bay (Playa Norte on Isla Mujeres, Las Perlas, Langosta, Tortugas, Caracol) get far less seaweed than the open sea side.'],
        ['🌅 Go early', 'Hotel and city crews rake the beach every morning, so 8–10 am is usually the cleanest time.'],
        ['🏝️ Islands help', 'In bad weeks, Isla Mujeres and Holbox are often clearer than the Hotel Zone\'s south end or Tulum.'],
        ['🏊 Have a plan B', 'Cenotes, pools and the bay side are seaweed-free all year. A hotel with a great pool matters more from May to August.'],
      ].map(([t, d]) => <div class="card p-5"><p class="font-bold text-navy">{t}</p><p class="mt-1 text-sm text-ink/70">{d}</p></div>)}
    </section>

    <section class="mt-8 card p-6">
      <h2 class="text-2xl font-bold text-navy">Questions</h2>
      <div class="mt-3 space-y-3">{faq.map(([q, a]) => <details class="rounded-xl bg-sand p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-2 text-sm text-ink/75">{a}</p></details>)}</div>
    </section>

    <p class="mt-6 text-sm text-ink/60">Source: {REPORT.source}. For today's map, check the <a href={REPORT.officialUrl} target="_blank" rel="noopener" class="font-semibold underline">official Red de Monitoreo del Sargazo page</a>. A "low" beach is not guaranteed seaweed-free.</p>
  </div>
  <script id="beaches" type="application/json" set:html={JSON.stringify({ beaches: BEACHES.filter((b) => b.at), levels: LEVELS })} />
</Base>
<style is:global>
  .sw-pin { width: 18px; height: 18px; border-radius: 9999px; border: 3px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.35); }
  .leaflet-popup-content { margin: 12px 14px; font-family: var(--font-sans); }
</style>
<script>
  import L from 'leaflet';
  const { beaches, levels } = JSON.parse(document.getElementById('beaches')!.textContent!);
  const map = L.map('map', { scrollWheelZoom: false }).setView([20.9, -87.0], 8);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19 }).addTo(map);
  const pts: [number, number][] = [];
  beaches.forEach((b: any) => {
    const lv = levels[b.level];
    const icon = L.divIcon({ className: '', html: `<div class="sw-pin" style="background:${lv.color}"></div>`, iconSize: [18, 18], iconAnchor: [9, 9] });
    L.marker(b.at, { icon, title: b.name }).bindPopup(`<p style="font-weight:700;color:#0A6E94;margin:0">${b.name}</p><p style="margin:2px 0;font-size:12px;color:#456">${b.area}</p><p style="margin:6px 0 0"><b style="color:${lv.color}">● ${lv.label}</b> (${lv.es})</p><p style="margin:4px 0 0;font-size:12px">${lv.advice}</p>`).addTo(map);
    if (!b.area.startsWith('Mahahual')) pts.push(b.at);
  });
  map.fitBounds(pts, { padding: [20, 20] });
  map.on('click', () => map.scrollWheelZoom.enable());
</script>
