---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { AREAS } from '../../lib/site';
const hotels = (await getCollection('hotels')).map((h) => ({
  id: h.id, name: h.data.name, area: h.data.area, areaLabel: AREAS[h.data.area]?.label ?? '',
  ai: h.data.allInclusive, adults: h.data.adultsOnly, price: h.data.priceLevel ?? 0,
  tags: h.data.bestFor, reviewed: !!h.data.review,
}));
---
<Base title="Which Cancún Hotel Is Right for Me? Free Hotel Matcher" description="Answer 6 quick questions and get the Cancún and Riviera Maya hotels that fit your group, budget and vibe — from a local who reviews them.">
  <section class="bg-navy py-10 text-white">
    <div class="wrap max-w-3xl">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Find your Cancún hotel</h1>
      <p class="mt-2 text-white/75">6 quick questions. No email, no sign-up.</p>
    </div>
  </section>
  <div class="wrap mt-8 max-w-3xl">
    <div id="quiz" class="card p-6">
      <div class="mb-5 h-1.5 overflow-hidden rounded-full bg-sand-2"><div id="bar" class="h-full bg-sun transition-all" style="width:0%"></div></div>
      <p id="step" class="text-sm font-semibold text-ink/50"></p>
      <h2 id="question" class="mt-1 text-xl font-bold text-navy"></h2>
      <div id="options" class="mt-5 grid gap-3 sm:grid-cols-2"></div>
      <div class="mt-6 flex justify-between">
        <button id="back" class="btn-ghost text-sm" type="button">← Back</button>
      </div>
    </div>
    <div id="results" class="hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-bold text-navy">Your best matches</h2>
        <button id="restart" class="btn-ghost text-sm" type="button">Start over</button>
      </div>
      <p id="summary" class="mt-2 text-sm text-ink/60"></p>
      <ol id="list" class="mt-5 space-y-4"></ol>
      <p class="mt-6 text-sm text-ink/60">Matches use each hotel's type (adults-only, all-inclusive, area) and what it's best for. Hotels marked ★ are reviewed on my YouTube channel. <a class="font-semibold underline" href="/hotels">Browse all hotels</a>.</p>
    </div>
  </div>
  <script id="hotel-data" type="application/json" set:html={JSON.stringify(hotels)} />
</Base>
<script>
  type H = { id: string; name: string; area: string; areaLabel: string; ai: boolean; adults: boolean; price: number; tags: string[]; reviewed: boolean };
  const HOTELS: H[] = JSON.parse(document.getElementById('hotel-data')!.textContent!);

  const Q = [
    { k: 'who', q: 'Who is coming on this trip?', o: [['couple', 'Just the two of us'], ['family-young', 'Family with young kids'], ['family-teens', 'Family with teens'], ['friends', 'Group of friends'], ['solo', 'Solo']] },
    { k: 'vibe', q: 'What kind of vacation do you want?', o: [['relax', 'Relax and do nothing'], ['party', 'Party and nightlife'], ['romance', 'Romantic / honeymoon'], ['explore', 'Explore tours and parks'], ['food', 'Great food above all']] },
    { k: 'kids', q: 'Do you want a kid-free resort?', o: [['adults', 'Yes, adults-only please'], ['any', "Doesn't matter"], ['family', 'No, we need a family resort']] },
    { k: 'plan', q: 'All-inclusive or not?', o: [['ai', 'All-inclusive, everything paid'], ['any', 'Either is fine'], ['ep', "Room only — I'll eat out"]] },
    { k: 'budget', q: 'What budget feels right?', o: [['1', 'Keep it affordable'], ['2', 'Mid-range'], ['3', 'Premium'], ['4', 'Treat ourselves — luxury']] },
    { k: 'where', q: 'Where do you want to be?', o: [['hotel-zone', 'Hotel Zone — walk to restaurants and clubs'], ['quiet', 'Somewhere quieter'], ['playa-del-carmen', 'Near Playa del Carmen and the parks'], ['any', 'No preference']] },
  ] as const;

  const ans: Record<string, string> = {};
  let i = 0;
  const el = (id: string) => document.getElementById(id)!;

  function draw() {
    const s = Q[i];
    el('bar').style.width = `${(i / Q.length) * 100}%`;
    el('step').textContent = `Question ${i + 1} of ${Q.length}`;
    el('question').textContent = s.q;
    el('options').innerHTML = s.o.map(([v, l]) => `<button type="button" class="opt" data-v="${v}" aria-pressed="${ans[s.k] === v}">${l}</button>`).join('');
    (el('back') as HTMLButtonElement).style.visibility = i ? 'visible' : 'hidden';
  }
  el('options').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    ans[Q[i].k] = b.dataset.v!;
    if (i < Q.length - 1) { i++; draw(); } else results();
  });
  el('back').addEventListener('click', () => { if (i) { i--; draw(); } });
  el('restart').addEventListener('click', () => { i = 0; for (const k in ans) delete ans[k]; el('results').classList.add('hidden'); el('quiz').classList.remove('hidden'); draw(); });

  function score(h: H) {
    let s = 0; const why: string[] = [];
    const kidsTrip = ans.who === 'family-young' || ans.who === 'family-teens';
    if (kidsTrip && h.adults) return null; // never suggest adults-only to families
    if (ans.kids === 'adults') { if (!h.adults) return null; s += 3; why.push('Adults-only'); }
    if (ans.kids === 'family') { if (h.adults) return null; s += 2; }
    if (kidsTrip && h.tags.includes('families')) { s += 4; why.push('Great for families'); }
    if (ans.who === 'couple' && (h.tags.includes('couples') || h.tags.includes('honeymoon'))) { s += 3; why.push('Popular with couples'); }
    if (ans.who === 'friends' && (h.tags.includes('groups') || h.tags.includes('party'))) { s += 3; why.push('Good for groups'); }
    if (ans.who === 'family-teens' && (h.tags.includes('theme-parks') || h.tags.includes('nightlife'))) s += 1;
    const vibeTags: Record<string, string[]> = { relax: ['quiet', 'luxury'], party: ['party', 'nightlife'], romance: ['honeymoon', 'couples', 'adults-only'], explore: ['theme-parks'], food: ['foodies', 'luxury'] };
    const hit = (vibeTags[ans.vibe] || []).filter((t) => h.tags.includes(t));
    if (hit.length) { s += 2 + hit.length; why.push({ relax: 'Relaxed feel', party: 'Party atmosphere', romance: 'Romantic', explore: 'Close to the parks', food: 'Strong food' }[ans.vibe]!); }
    if (ans.vibe === 'party' && h.tags.includes('quiet')) s -= 3;
    if (ans.vibe === 'relax' && h.tags.includes('party')) s -= 3;
    if (ans.plan === 'ai') { if (h.ai) { s += 2; why.push('All-inclusive'); } else s -= 3; }
    if (ans.plan === 'ep') { if (!h.ai) { s += 3; why.push('Room-only rates'); } else s -= 1; }
    if (h.price) { const d = Math.abs(h.price - Number(ans.budget)); s += d === 0 ? 3 : d === 1 ? 1 : -2; if (d === 0) why.push('Fits your budget'); }
    if (ans.where === 'hotel-zone' && h.area === 'hotel-zone') { s += 2; why.push('In the Hotel Zone'); }
    if (ans.where === 'playa-del-carmen' && h.area === 'playa-del-carmen') { s += 3; why.push('Near Playa del Carmen'); }
    if (ans.where === 'quiet' && (h.area !== 'hotel-zone' || h.tags.includes('quiet'))) { s += 2; why.push('Quieter location'); }
    if (h.reviewed) s += 0.5;
    return { h, s, why: [...new Set(why)].slice(0, 4) };
  }

  function results() {
    const ranked = HOTELS.map(score).filter((x): x is NonNullable<ReturnType<typeof score>> => !!x).sort((a, b) => b.s - a.s).slice(0, 5);
    el('quiz').classList.add('hidden'); el('results').classList.remove('hidden');
    const label = (k: string) => (Q.find((q) => q.k === k)!.o as readonly (readonly [string, string])[]).find(([v]) => v === ans[k])?.[1];
    el('summary').textContent = `${label('who')} · ${label('vibe')} · ${label('budget')}`;
    el('list').innerHTML = ranked.length ? ranked.map((r, n) => `
      <li class="card flex gap-4 p-5">
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full ${n === 0 ? 'bg-sun' : 'bg-sand-2'} font-bold text-navy">${n + 1}</span>
        <div class="min-w-0 flex-1">
          <a href="/hotels/${r.h.id}" class="text-lg font-bold text-navy hover:underline">${r.h.reviewed ? '★ ' : ''}${r.h.name}</a>
          <p class="text-sm text-ink/60">${r.h.areaLabel} · ${r.h.ai ? 'All-inclusive' : 'Room only'} · ${r.h.adults ? 'Adults-only' : 'Kids welcome'}</p>
          <div class="mt-2 flex flex-wrap gap-1.5">${r.why.map((w) => `<span class="chip">${w}</span>`).join('')}</div>
        </div>
        <a href="/hotels/${r.h.id}" class="btn-sun hidden self-center text-sm sm:inline-flex">View</a>
      </li>`).join('') : '<li class="card p-6">No exact match yet — try "Doesn\'t matter" on a question or two. More hotels are being added every week.</li>';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  draw();
</script>
