---
import Base from '../../layouts/Base.astro';
import { TOURS, INTEREST_LABELS } from '../../data/tours';
---
<Base title="Which Cancún Tours Should I Do? Free Tour Finder" description="Pick what you like and when you're going — get the Cancún and Riviera Maya tours and day trips that actually fit you, with honest local tips.">
  <section class="bg-navy py-10 text-white">
    <div class="wrap max-w-3xl">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Find your perfect tours</h1>
      <p class="mt-2 text-white/75">Tell me what you like. I'll tell you what's worth your vacation days — and what to skip.</p>
    </div>
  </section>
  <div class="wrap mt-8 grid max-w-5xl gap-8 lg:grid-cols-[360px_1fr]">
    <form id="f" class="card space-y-6 self-start p-5" onsubmit="return false">
      <fieldset>
        <legend class="font-bold text-navy">What do you love? <span class="font-normal text-ink/50">(pick any)</span></legend>
        <div class="mt-3 grid grid-cols-2 gap-2" id="interests">
          {Object.entries(INTEREST_LABELS).map(([k, l]) => <button type="button" class="opt px-3 py-2 text-sm" data-i={k} aria-pressed="false">{l}</button>)}
        </div>
      </fieldset>
      <label class="block"><span class="font-bold text-navy">When are you going?</span>
        <select id="month" class="field mt-2">
          <option value="">Not sure yet</option>
          {['January','February','March','April','May','June','July','August','September','October','November','December'].map((m, i) => <option value={i + 1}>{m}</option>)}
        </select>
      </label>
      <label class="block"><span class="font-bold text-navy">Kids coming?</span>
        <select id="kids" class="field mt-2"><option value="none">No kids</option><option value="young">Yes, under 10</option><option value="teens">Yes, teens</option></select>
      </label>
      <fieldset>
        <legend class="font-bold text-navy">How active?</legend>
        <div class="mt-2 grid grid-cols-3 gap-2" id="energy">
          <button type="button" class="opt px-2 py-2 text-center text-sm" data-e="1" aria-pressed="false">Easy</button>
          <button type="button" class="opt px-2 py-2 text-center text-sm" data-e="2" aria-pressed="true">Some walking</button>
          <button type="button" class="opt px-2 py-2 text-center text-sm" data-e="3" aria-pressed="false">Bring it on</button>
        </div>
      </fieldset>
    </form>
    <div>
      <div id="season" class="space-y-2"></div>
      <p id="hint" class="card p-6 text-ink/60">Pick at least one interest to see your tours.</p>
      <ol id="list" class="space-y-4"></ol>
    </div>
  </div>
  <script id="tour-data" type="application/json" set:html={JSON.stringify(TOURS)} />
</Base>
<script>
  import { rankTours, seasonNote, type Prefs } from '../../lib/tourMatch';
  import type { Tour } from '../../data/tours';
  const TOURS: Tour[] = JSON.parse(document.getElementById('tour-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const p: Prefs = { interests: [], kids: 'none', energy: 2 };

  $('interests').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
    const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on));
    const k = b.dataset.i as any; p.interests = on ? [...p.interests, k] : p.interests.filter((x) => x !== k); draw();
  });
  $('energy').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
    $('energy').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    p.energy = Number(b.dataset.e) as 1 | 2 | 3; draw();
  });
  $('month').addEventListener('change', (e) => { p.month = Number((e.target as HTMLSelectElement).value) || undefined; draw(); });
  $('kids').addEventListener('change', (e) => { p.kids = (e.target as HTMLSelectElement).value as Prefs['kids']; draw(); });

  function draw() {
    $('season').innerHTML = seasonNote(p.month).map((n) => `<p class="rounded-xl bg-sun/30 px-4 py-2.5 text-sm">${n}</p>`).join('');
    $('hint').style.display = p.interests.length ? 'none' : '';
    const ranked = p.interests.length ? rankTours(TOURS, p).slice(0, 6) : [];
    $('list').innerHTML = ranked.map((m, n) => `
      <li class="card p-5">
        <div class="flex items-start gap-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full ${n === 0 ? 'bg-sun' : 'bg-sand-2'} text-sm font-bold text-navy">${n + 1}</span>
          <div class="min-w-0">
            <a href="/tours/${m.tour.slug}" class="text-lg font-bold text-navy hover:underline">${m.tour.name}</a>
            <p class="text-sm text-ink/70">${m.tour.short}</p>
            <p class="mt-1 text-xs text-ink/50">${m.tour.length === 'half' ? 'Half day' : 'Full day'} · ${m.tour.travel}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">${m.why.map((w) => `<span class="chip">${w}</span>`).join('')}</div>
            <p class="mt-3 rounded-lg bg-sand px-3 py-2 text-sm"><b>Local tip:</b> ${m.tour.localTip}</p>
            ${m.warn ? `<p class="mt-2 text-sm font-semibold text-[#9a5b00]">⚠ ${m.warn}</p>` : ''}
          </div>
        </div>
      </li>`).join('') || (p.interests.length ? '<li class="card p-6">Nothing matches every filter — try another month or interest.</li>' : '');
  }
  draw();
</script>
