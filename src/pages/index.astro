---
import Base from '../layouts/Base.astro';
import HotelCard from '../components/HotelCard.astro';
import { getCollection } from 'astro:content';
import { TOURS } from '../data/tours';
import { AREAS, SITE } from '../lib/site';
const hotels = await getCollection('hotels');
const reviewed = hotels.filter((h) => h.data.review);
const featured = [...reviewed, ...hotels.filter((h) => !h.data.review && !h.data.needsReview)].slice(0, 6);
const topTours = ['whale-shark-tour-cancun', 'chichen-itza-day-trip', 'isla-mujeres-day-trip', 'cenote-tour'].map((s) => TOURS.find((t) => t.slug === s)!);
const areaPick = ['hotel-zone', 'playa-del-carmen', 'south-cancun', 'costa-mujeres'];
---
<Base title={`${SITE.name}: Honest Cancún & Riviera Maya Travel Guide From a Local`} description="Honest hotel reviews with real scores, tours worth your time, airport tips and free trip-planning tools for Cancún and the Riviera Maya — from a local."
  schema={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: Astro.site?.href }}>
  <section class="relative overflow-hidden bg-navy text-white">
    <svg class="absolute -right-20 -top-10 h-[420px] w-[420px] opacity-20" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="60" fill="#FFD54A"/><path d="M0 150c30-20 60-20 100 0s70 20 100 0" stroke="#7ABFCC" stroke-width="6" fill="none"/><path d="M0 170c30-20 60-20 100 0s70 20 100 0" stroke="#7ABFCC" stroke-width="6" fill="none"/></svg>
    <div class="wrap relative py-16 sm:py-24">
      <p class="eyebrow">Cancún · Playa del Carmen · Tulum</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">Plan your Riviera Maya trip with a <span class="text-sun">local</span>.</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/75">Honest hotel reviews with real scores, the tours that are actually worth it, and free tools to plan every day — no hype.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/tools/trip-planner" class="btn-sun">Plan my trip — free</a>
        <a href="/tools/hotel-match" class="btn-ghost-dark">Find my hotel</a>
      </div>
    </div>
  </section>

  <section class="wrap -mt-8 relative grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {[
      ['/tools/trip-planner', '🗓️', 'Trip planner', 'Day-by-day plan in a minute'],
      ['/tools/hotel-match', '🏨', 'Hotel matcher', '6 questions, your best hotels'],
      ['/tools/tour-finder', '🐋', 'Tour finder', 'What to do — and what to skip'],
      ['/guides/cancun-airport', '✈️', 'Airport guide', 'Plane to pool, no scams'],
    ].map(([href, icon, name, sub]) => (
      <a href={href} class="card group flex items-center gap-4 p-5 transition hover:-translate-y-0.5 hover:shadow-md">
        <span class="text-3xl" aria-hidden="true">{icon}</span>
        <span><span class="block font-bold text-navy group-hover:underline">{name}</span><span class="text-sm text-ink/60">{sub}</span></span>
      </a>
    ))}
  </section>

  <section class="wrap mt-16">
    <div class="flex items-end justify-between gap-4">
      <div><p class="eyebrow">Hotels</p><h2 class="mt-1 text-3xl font-bold text-navy">Honest hotel reviews</h2></div>
      <a href="/hotels" class="hidden font-semibold text-navy underline decoration-gold decoration-2 underline-offset-4 sm:inline">All hotels →</a>
    </div>
    <p class="mt-2 max-w-2xl text-ink/70">I only score hotels I've actually stayed in, and I show what I paid. Everything else gets checked facts — never invented reviews.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{featured.map((h) => <HotelCard hotel={h} />)}</div>
  </section>

  <section class="wrap mt-16">
    <p class="eyebrow">Where to stay</p>
    <h2 class="mt-1 text-3xl font-bold text-navy">Pick your area first</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {areaPick.map((a) => (
        <a href={`/hotels?area=${a}`} class="card group p-5 hover:shadow-md">
          <p class="font-bold text-navy group-hover:underline">{AREAS[a].label}</p>
          <p class="mt-1 text-sm text-ink/70">{AREAS[a].blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16 bg-white py-14">
    <div class="wrap">
      <div class="flex items-end justify-between gap-4">
        <div><p class="eyebrow">Tours</p><h2 class="mt-1 text-3xl font-bold text-navy">Worth your vacation days</h2></div>
        <a href="/tours" class="hidden font-semibold text-navy underline decoration-gold decoration-2 underline-offset-4 sm:inline">All tours →</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {topTours.map((t) => (
          <a href={`/tours/${t.slug}`} class="group rounded-2xl bg-sand p-5 hover:shadow-md">
            <p class="font-bold text-navy group-hover:underline">{t.name}</p>
            <p class="mt-1 text-sm text-ink/70">{t.short}</p>
          </a>
        ))}
      </div>
      <a href="/tools/tour-finder" class="btn-sun mt-8">Which tours fit me? →</a>
    </div>
  </section>

  <section class="wrap mt-16">
    <div class="grid items-center gap-8 rounded-3xl bg-navy p-8 text-white sm:p-12 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow">On YouTube</p>
        <h2 class="mt-1 text-3xl font-bold">Watch the full reviews</h2>
        <p class="mt-2 max-w-xl text-white/75">Every reviewed hotel and tour has a video: the room, the food, the beach and the honest verdict — so you know exactly what you're booking.</p>
      </div>
      <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="btn bg-[#ff0033] text-white hover:brightness-110">Subscribe to BostonVentures</a>
    </div>
  </section>
</Base>
