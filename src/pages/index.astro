---
import Base from '../layouts/Base.astro';
import TodayBox from '../components/TodayBox.astro';
import HotelCard from '../components/HotelCard.astro';
import { getCollection } from 'astro:content';
import { TOURS } from '../data/tours';
import { AREAS, SITE } from '../lib/site';
const hotels = await getCollection('hotels');
const reviewed = hotels.filter((h) => h.data.review);
const featured = [...reviewed, ...hotels.filter((h) => !h.data.review && !h.data.needsReview)].slice(0, 6);
const topTours = ['whale-shark-tour-cancun', 'chichen-itza-day-trip', 'isla-mujeres-day-trip', 'cenote-tour'].map((s) => TOURS.find((t) => t.slug === s)!);
const reviewedCount = reviewed.length;
const videoTours = TOURS.filter((t) => t.reviewed?.videoId).length;
const hotelCount = hotels.filter((h) => !h.data.needsReview).length;
const guideCount = (await getCollection('guides')).length + 1; // + the airport guide page
const areaPick = ['hotel-zone', 'playa-del-carmen', 'south-cancun', 'costa-mujeres'];
---
<Base title={`${SITE.name}: Honest Cancún & Riviera Maya Travel Guide From a Local`} description="Honest hotel reviews with real scores, tours worth your time, airport tips and free trip-planning tools for Cancún and the Riviera Maya — from a local."
>
  <section class="relative overflow-hidden bg-navy pb-10 text-white">
    <div class="wrap relative py-16 sm:py-24">
      <p class="eyebrow">Cancún · Playa del Carmen · Tulum</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">Plan your
        <span class="rotator text-sun" aria-label="Riviera Maya trip"><span class="on">beach escape</span><span>food crawl</span><span>whale shark swim</span><span>cenote day</span><span>family trip</span></span>
        <br class="hidden sm:block" />with a local.</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/75">100% free, no sign-up. Honest hotel reviews with real scores, the tours that are actually worth it, and free tools to plan every day — no hype.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/tools/trip-planner" class="btn-sun">Plan my trip — free</a>
        <a href="/tools/hotel-match" class="btn-ghost-dark">Find my hotel</a>
      </div>
      <dl class="mt-10 grid max-w-3xl grid-cols-2 gap-x-10 gap-y-4 sm:grid-cols-4">
        <div><dt class="text-xs font-bold uppercase tracking-widest text-teal">Hotels reviewed</dt><dd class="font-serif text-4xl font-bold"><span class="countup" data-to={reviewedCount}>0</span></dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-widest text-teal">Tours on video</dt><dd class="font-serif text-4xl font-bold"><span class="countup" data-to={videoTours}>0</span></dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-widest text-teal">Hotels compared</dt><dd class="font-serif text-4xl font-bold"><span class="countup" data-to={hotelCount}>0</span></dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-widest text-teal">Local guides</dt><dd class="font-serif text-4xl font-bold"><span class="countup" data-to={guideCount}>0</span></dd></div>
      </dl>
    </div>
    <div class="waves" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none"><path d="M0 40 C120 20 240 20 360 40 S600 60 720 40 S960 20 1080 40 S1320 60 1440 40 V70 H0Z" fill="#F3F8F7"/></svg>
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none"><path d="M0 30 C150 50 210 10 360 30 S570 50 720 30 S930 10 1080 30 S1290 50 1440 30 V70 H0Z" fill="#F3F8F7"/></svg>
    </div>
  </section>

  <section class="wrap relative z-10 -mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {[
      ['/tools/trip-planner', '🗓️', 'Trip planner', 'Day-by-day plan in a minute'],
      ['/tools/hotel-match', '🏨', 'Hotel matcher', '6 questions, your best hotels'],
      ['/tools/tour-finder', '🐋', 'Tour finder', 'What to do — and what to skip'],
      ['/map', '🗺️', 'Map', 'Every hotel and tour on one map'],
    ].map(([href, icon, name, sub]) => (
      <a href={href} class="card lift reveal group flex items-center gap-4 p-5">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-sand-2 text-2xl transition group-hover:scale-110 group-hover:-rotate-6" aria-hidden="true">{icon}</span>
        <span><span class="block font-bold text-navy group-hover:underline">{name}</span><span class="text-sm text-ink/60">{sub}</span></span>
      </a>
    ))}
  </section>

  <section class="wrap mt-10"><TodayBox /></section>

  <section class="wrap mt-16">
    <div class="flex items-end justify-between gap-4">
      <div><p class="eyebrow">Hotels</p><h2 class="mt-1 text-3xl font-bold text-navy">Honest hotel reviews</h2></div>
      <a href="/hotels" class="hidden font-semibold text-navy underline decoration-gold decoration-2 underline-offset-4 sm:inline">All hotels →</a>
    </div>
    <p class="mt-2 max-w-2xl text-ink/70">I only score hotels I've actually stayed in, and I show what I paid. Everything else gets checked facts — never invented reviews.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{featured.map((h) => <HotelCard hotel={h} />)}</div>
  </section>

  <section class="wrap mt-16">
    <p class="eyebrow">Where to stay</p>
    <h2 class="mt-1 text-3xl font-bold text-navy">Pick your area first</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {areaPick.map((a) => (
        <a href={`/hotels?area=${a}`} class="card lift reveal group p-5">
          <p class="font-bold text-navy group-hover:underline">{AREAS[a].label}</p>
          <p class="mt-1 text-sm text-ink/70">{AREAS[a].blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16 bg-white py-14">
    <div class="wrap">
      <div class="flex items-end justify-between gap-4">
        <div><p class="eyebrow">Tours</p><h2 class="mt-1 text-3xl font-bold text-navy">Worth your vacation days</h2></div>
        <a href="/tours" class="hidden font-semibold text-navy underline decoration-gold decoration-2 underline-offset-4 sm:inline">All tours →</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {topTours.map((t) => (
          <a href={`/tours/${t.slug}`} class="lift reveal group rounded-2xl bg-sand p-5">
            <p class="font-bold text-navy group-hover:underline">{t.name}</p>
            <p class="mt-1 text-sm text-ink/70">{t.short}</p>
          </a>
        ))}
      </div>
      <a href="/tools/tour-finder" class="btn-sun mt-8">Which tours fit me? →</a>
    </div>
  </section>

  <section class="wrap mt-16">
    <div class="reveal grid items-center gap-8 rounded-3xl bg-navy p-8 text-white sm:p-12 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow">On YouTube</p>
        <h2 class="mt-1 text-3xl font-bold">Watch the full reviews</h2>
        <p class="mt-2 max-w-xl text-white/75">Every reviewed hotel and tour has a video: the room, the food, the beach and the honest verdict — so you know exactly what you're booking.</p>
      </div>
      <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="btn bg-[#ff0033] text-white hover:brightness-110">Subscribe to BostonVentures</a>
    </div>
  </section>
</Base>
<script>
  const words = [...document.querySelectorAll<HTMLElement>('.rotator > span')];
  let i = 0;
  if (words.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { words[i].classList.remove('on'); i = (i + 1) % words.length; words[i].classList.add('on'); }, 2200);
  document.querySelectorAll<HTMLElement>('.countup').forEach((el) => {
    const to = Number(el.dataset.to), t0 = performance.now();
    const step = (t: number) => { const k = Math.min(1, (t - t0) / 1200); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  });
</script>
