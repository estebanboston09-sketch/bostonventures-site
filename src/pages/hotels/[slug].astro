---
import Base from '../../layouts/Base.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import ReviewExplorer from '../../components/ReviewExplorer.astro';
import { splitSections } from '../../lib/sections';
import LiteYouTube from '../../components/LiteYouTube.astro';
import TravelEssentials from '../../components/TravelEssentials.astro';
import Disclosure from '../../components/Disclosure.astro';
import HotelCard from '../../components/HotelCard.astro';
import AreaArt from '../../components/AreaArt.astro';
import TravelersSay from '../../components/TravelersSay.astro';
import { hotelImage } from '../../lib/hotelImage';
import { overallScore } from '../../lib/score';
import { getCollection, render } from 'astro:content';
import { AREAS, SITE, AFFILIATE } from '../../lib/site';

export async function getStaticPaths() {
  const hotels = await getCollection('hotels');
  return hotels.map((h) => ({ params: { slug: h.id }, props: { hotel: h, all: hotels } }));
}
const { hotel, all } = Astro.props;
const d = hotel.data;
const { Content } = await render(hotel);
const r = d.review;
const reviewed = !!r;
const parsed = reviewed ? splitSections(hotel.body ?? '', r?.chapters) : null;
const area = AREAS[d.area];
const year = new Date().getFullYear();
const monthName = (ym?: string) => (ym && ym.length >= 7 ? new Date(ym + '-15').toLocaleString('en-US', { month: 'long', year: 'numeric' }) : ym);

const title = reviewed ? `${d.name} Review (${year}): Honest Local Take` : `${d.name}: What to Know Before Booking`;
const description = reviewed
  ? `My honest video review of ${d.name} after a real stay: the room, food, beach and pool, activities and service, plus who should book it and who should skip it.`
  : `${d.name} in ${area?.label ?? 'the Riviera Maya'}: ${d.allInclusive ? 'all-inclusive' : 'room-only'}, ${d.adultsOnly ? 'adults-only' : 'family-friendly'}. Checked facts, getting there from the airport and local tips.`;

// Similar hotels: same adults-only setting, shared tags, prefer reviewed.
const similar = all
  .filter((h) => h.id !== hotel.id && h.data.adultsOnly === d.adultsOnly)
  .map((h) => ({ h, s: h.data.bestFor.filter((t) => d.bestFor.includes(t)).length + (h.data.area === d.area ? 1 : 0) + (h.data.review ? 0.5 : 0) }))
  .sort((a, b) => b.s - a.s).slice(0, 3).map((x) => x.h);
const reviewedSimilar = all.find((h) => h.id !== hotel.id && h.data.review && h.data.adultsOnly === d.adultsOnly);

const img = hotelImage(d);
const videoId = r?.videoId;
const bookUrl = AFFILIATE.hotelBooking ? AFFILIATE.hotelBooking.url(d.name) : d.officialUrl;

const schema: any[] = [
  {
    '@context': 'https://schema.org', '@type': 'Hotel', name: d.name,
    ...(d.address && { address: { '@type': 'PostalAddress', streetAddress: d.address, addressLocality: 'Cancún', addressRegion: 'Quintana Roo', addressCountry: 'MX' } }),
    ...(d.officialUrl && { url: d.officialUrl }),
    ...(overallScore(r) != null && {
      review: { '@type': 'Review', author: { '@type': 'Person', name: 'Esteban (BostonVentures)' },
        reviewRating: { '@type': 'Rating', ratingValue: overallScore(r), bestRating: 10, worstRating: 0 } },
    }),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Hotels', item: new URL('/hotels', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.name },
  ] },
];
if (r?.videoId) schema.push({ '@context': 'https://schema.org', '@type': 'VideoObject', name: `${d.name} review`, thumbnailUrl: `https://i.ytimg.com/vi/${r.videoId}/hqdefault.jpg`, embedUrl: `https://www.youtube.com/embed/${r.videoId}`, uploadDate: r.videoDate ?? r.visited });
---
<Base title={title} description={description} schema={schema} noindex={d.needsReview}>
  <section class="relative overflow-hidden bg-navy pb-12 pt-8 text-white">
    {img
      ? (videoId && !d.photos.length
          ? <img src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`} alt="" data-yt-hero class="absolute inset-0 h-full w-full object-cover" />
          : <img src={img.src} alt="" class="absolute inset-0 h-full w-full object-cover" />)
      : <AreaArt area={d.area} seed={hotel.id} class="absolute inset-0 h-full w-full" />}
    {img && d.photos[0]?.credit && <a href={d.photos[0].creditUrl} target="_blank" rel="noopener nofollow" class="absolute bottom-2 right-3 z-10 text-[10px] text-white/70 hover:text-white">Photo: {d.photos[0].credit}{d.photos[0].license && <> · {d.photos[0].license}</>}</a>}
    <div class="absolute inset-0 bg-gradient-to-r from-[#063f56]/90 via-[#063f56]/65 to-[#063f56]/20"></div>
    <div class="wrap relative">
      <nav class="text-sm text-white/70"><a href="/hotels" class="hover:text-white">Hotels</a> / <a href={`/hotels?area=${d.area}`} class="hover:text-white">{area?.label}</a></nav>
      <div class="mt-16 sm:mt-24">
        {reviewed ? (
          <span class="inline-flex items-center gap-2 rounded-full bg-sun px-3 py-1 text-xs font-bold uppercase tracking-wide text-navy">★ Reviewed by BostonVentures{r?.videoDate ? <> · video {monthName(r.videoDate)}</> : r?.visited && r.visited.length >= 7 && <> · visited {monthName(r.visited)}</>}</span>
        ) : (
          <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3 py-1 text-xs font-bold uppercase tracking-wide backdrop-blur">Not reviewed yet</span>
        )}
      </div>
      <h1 class="mt-3 max-w-3xl text-3xl font-bold drop-shadow sm:text-5xl">{d.name}</h1>
      <p class="mt-2 text-teal">{area?.label}{d.brand && <> · {d.brand}</>}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="rounded-full border border-white/40 bg-white/10 px-3 py-1 text-sm backdrop-blur">{d.allInclusive ? 'All-inclusive' : 'Not all-inclusive'}</span>
        <span class="rounded-full border border-white/40 bg-white/10 px-3 py-1 text-sm backdrop-blur">{d.adultsOnly ? 'Adults-only' : 'Kids welcome'}</span>
        {d.priceLevel && <span class="rounded-full border border-white/40 bg-white/10 px-3 py-1 text-sm backdrop-blur">{['', 'Budget', 'Mid-range', 'Premium', 'Luxury'][d.priceLevel]}</span>}
      </div>
      {videoId && (
        <a href="#video" class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#ff0033] px-5 py-3 font-bold text-white shadow-lg hover:brightness-110">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z"/></svg> Watch my video review
        </a>
      )}
    </div>
  </section>

  <div class="wrap mt-8 grid gap-8 lg:grid-cols-[1fr_340px]">
    <article class="min-w-0 space-y-8">
      {d.needsReview && (
        <p class="rounded-xl border-2 border-dashed border-gold bg-white p-4 text-sm"><b>Draft page.</b> Basic facts still need Esteban's check before launch. This page is hidden from Google until then.</p>
      )}

      {reviewed && r && <VerdictCard review={r} />}

      {videoId && (
        <section id="video" class="reveal scroll-mt-24">
          <div class="mb-3 flex items-center justify-between gap-3">
            <h2 class="text-2xl font-bold text-navy">Watch my full review</h2>
            <a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener" class="text-sm font-semibold text-navy underline">Open on YouTube</a>
          </div>
          <LiteYouTube id={videoId} title={`${d.name} review`} chapters={r?.chapters} />
        </section>
      )}

      {parsed?.intro && <div class="prose-bv reveal text-lg" set:html={parsed.intro} />}
      {parsed && parsed.sections.length > 0 && <ReviewExplorer sections={parsed.sections} />}

      {d.photos.length > 1 && (
        <section class="reveal grid grid-cols-2 gap-3 sm:grid-cols-3">
          {d.photos.slice(1, 7).map((p) => <img src={p.src} alt={p.alt} loading="lazy" class="aspect-[4/3] w-full rounded-xl object-cover transition hover:scale-[1.02]" />)}
        </section>
      )}
      {reviewed && r && (r.roomStayed || r.comped) && (
        <p class="text-sm text-ink/60">{r.roomStayed && <>Room I stayed in: {r.roomStayed}. </>}{r.comped && <>This stay was provided by the hotel. That never changes my scores — <a class="underline" href="/review-policy">see how reviews work</a>.</>}</p>
      )}

      {!reviewed && (
        <section class="card reveal p-6">
          <p class="eyebrow">What to know before booking</p>
          <p class="mt-2 text-sm text-ink/70">I haven't stayed here yet, so there are no scores — just checked facts.{reviewedSimilar && <> Want a real review of something similar? See <a class="font-semibold underline" href={`/hotels/${reviewedSimilar.id}`}>{reviewedSimilar.data.name}</a>.</>}</p>
          <a href={`mailto:${SITE.email}?subject=Review request: ${encodeURIComponent(d.name)}`} class="btn-ghost mt-4 text-sm">Request a review of this hotel</a>
        </section>
      )}

      {(d.about || d.amenities.length > 0) && (
        <section class="card reveal p-6">
          <p class="eyebrow">About this hotel</p>
          {d.about && <p class="mt-2 text-ink/80">{d.about}</p>}
          {(d.rooms || d.restaurants || d.airportMinutes) && (
            <div class="mt-5 grid grid-cols-3 gap-3 text-center">
              {d.rooms && <div class="rounded-xl bg-sand p-3"><p class="text-2xl font-bold text-navy">{d.rooms}</p><p class="text-xs text-ink/60">rooms</p></div>}
              {d.restaurants && <div class="rounded-xl bg-sand p-3"><p class="text-2xl font-bold text-navy">{d.restaurants}</p><p class="text-xs text-ink/60">restaurants</p></div>}
              {d.airportMinutes && <div class="rounded-xl bg-sand p-3"><p class="text-2xl font-bold text-navy">~{d.airportMinutes}</p><p class="text-xs text-ink/60">min from airport</p></div>}
            </div>
          )}
          {d.amenities.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{d.amenities.map((a) => <span class="chip">{a}</span>)}</div>}
          {d.beach && <p class="mt-4 text-sm text-ink/70"><b>Beach:</b> {d.beach}</p>}
        </section>
      )}

      {(d.dining.length > 0 || d.practical.length > 0) && (
        <section class="card reveal p-6">
          {d.dining.length > 0 && <>
            <p class="eyebrow">Restaurants & bars</p>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {d.dining.map((r) => <li class="lift flex items-baseline justify-between gap-3 rounded-xl bg-sand p-3"><span class="font-semibold text-navy">{r.name}</span><span class="text-right text-xs text-ink/60">{r.type}</span></li>)}
            </ul>
          </>}
          {d.practical.length > 0 && <>
            <p class={`eyebrow ${d.dining.length ? 'mt-6' : ''}`}>Practical info</p>
            <dl class="mt-3 divide-y divide-sand-2 text-sm">
              {d.practical.map((x) => <div class="flex justify-between gap-4 py-2"><dt class="text-ink/60">{x.label}</dt><dd class="text-right font-medium">{x.value}</dd></div>)}
            </dl>
          </>}
          {d.officialUrl && <a href={d.officialUrl} target="_blank" rel="noopener" class="btn-ghost mt-5 inline-flex">📸 See the hotel's official photos</a>}
        </section>
      )}

      {(d.highlights.length > 0 || d.goodToKnow.length > 0) && (
        <section class="grid gap-5 sm:grid-cols-2">
          {d.highlights.length > 0 && <div class="card reveal p-5"><p class="font-bold text-navy">✨ Highlights</p><ul class="mt-3 space-y-2 text-sm">{d.highlights.map((x) => <li class="flex gap-2"><span class="text-gold">●</span><span>{x}</span></li>)}</ul></div>}
          {d.goodToKnow.length > 0 && <div class="card reveal border-l-4 border-sun p-5" style="--d:120ms"><p class="font-bold text-navy">💡 Good to know</p><ul class="mt-3 space-y-2 text-sm">{d.goodToKnow.map((x) => <li class="flex gap-2"><span class="text-sun">●</span><span>{x}</span></li>)}</ul></div>}
        </section>
      )}

      {d.travelers && <TravelersSay t={d.travelers} name={d.name} />}

      {!reviewed && <div class="prose-bv"><Content /></div>}

      <section>
        <h2 class="text-xl font-bold text-navy">Getting there from Cancún airport</h2>
        <p class="mt-2 text-sm text-ink/70">{d.airportMinutes ? `About ${d.airportMinutes} minutes by car from Cancún airport (CUN).` : `See our airport guide for the best way to get to ${area?.label ?? 'your hotel'}.`} <a class="font-semibold underline" href="/guides/cancun-airport">Read the airport arrival guide</a>.</p>
        <div class="mt-4"><TravelEssentials /></div>
      </section>

      {d.sources.length > 0 && (
        <p class="text-xs text-ink/50">Facts last checked: {monthName(d.factsChecked) ?? 'recently'}. Sources: {d.sources.map((s, i) => <><a href={s.url} class="underline" rel="nofollow noopener" target="_blank">{new URL(s.url).hostname.replace('www.', '')}</a>{i < d.sources.length - 1 && ', '}</>)}. Always confirm details with the hotel before booking.</p>
      )}
    </article>

    <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
      <div class="card p-5">
        <p class="font-bold text-navy">Quick facts</p>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-ink/60">Area</dt><dd class="text-right font-semibold">{area?.label}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink/60">Meal plan</dt><dd class="text-right font-semibold">{d.allInclusive ? 'All-inclusive' : 'Room only / optional'}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink/60">Who</dt><dd class="text-right font-semibold">{d.adultsOnly ? 'Adults only' : 'All ages'}</dd></div>
          {d.rooms && <div class="flex justify-between gap-3"><dt class="text-ink/60">Rooms</dt><dd class="text-right font-semibold">~{d.rooms.toLocaleString()}</dd></div>}
          {d.restaurants && <div class="flex justify-between gap-3"><dt class="text-ink/60">Restaurants</dt><dd class="text-right font-semibold">{d.restaurants}</dd></div>}
          {d.airportMinutes && <div class="flex justify-between gap-3"><dt class="text-ink/60">From airport</dt><dd class="text-right font-semibold">~{d.airportMinutes} min</dd></div>}
          {d.address && <div class="flex justify-between gap-3"><dt class="text-ink/60">Address</dt><dd class="text-right font-semibold">{d.address}</dd></div>}
          {d.priceRangeUSD && <div class="flex justify-between gap-3"><dt class="text-ink/60">Typical price</dt><dd class="text-right font-semibold">${d.priceRangeUSD.low}–${d.priceRangeUSD.high}/night</dd></div>}
        </dl>
        {bookUrl && <a href={bookUrl} target="_blank" rel={AFFILIATE.hotelBooking ? 'sponsored nofollow noopener' : 'noopener'} class="btn-sun mt-5 w-full">Check prices →</a>}
        <a href={AFFILIATE.transfers.url} target="_blank" rel="sponsored nofollow noopener" class="btn-ghost mt-2 w-full text-sm">Book airport transfer</a>
        <a href={`/hotels/compare?h=${[hotel.id, ...similar.slice(0, 1).map((x) => x.id)].join(',')}`} class="btn-ghost mt-2 w-full text-sm">⚖️ Compare with similar</a>
      </div>
      <div class="card p-5">
        <p class="font-bold text-navy">Best for</p>
        <div class="mt-3 flex flex-wrap gap-1.5">{d.bestFor.map((t) => <span class="chip capitalize">{t.replace('-', ' ')}</span>)}</div>
      </div>
      <Disclosure />
    </aside>
  </div>

  {similar.length > 0 && (
    <section class="wrap mt-14">
      <h2 class="text-2xl font-bold text-navy">Similar hotels</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{similar.map((h) => <HotelCard hotel={h} />)}</div>
    </section>
  )}
  {reviewed && (
    <section class="wrap mt-12">
      <div class="flex flex-col items-start gap-4 rounded-2xl bg-navy p-6 text-white sm:flex-row sm:items-center sm:justify-between">
        <p class="text-lg font-semibold">Want more honest hotel reviews from Cancún?</p>
        <a href={SITE.youtubeSubscribe} target="_blank" rel="noopener" class="btn-sun">Subscribe on YouTube</a>
      </div>
    </section>
  )}
  <script is:inline>
    (function(){var i=document.querySelector('[data-yt-hero]');if(!i)return;var steps=['sddefault','hqdefault'];
      function next(){var n=steps.shift();if(!n)return;i.src=i.src.replace(/(maxres|sd)default/,n);}
      function check(){if(i.naturalWidth&&i.naturalWidth<=120)next();}
      i.addEventListener('load',check);i.addEventListener('error',next);if(i.complete)check();})();
  </script>
</Base>
